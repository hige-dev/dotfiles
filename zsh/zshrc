# Powerlevel10k のプロンプトを早期表示
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Apple Silicon / Intel の Homebrew をシェルに反映
if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /usr/local/bin/brew ]]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi
typeset -U path
path=("$HOME/.local/bin" /opt/nvim-linux-x86_64/bin $path)
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="powerlevel10k/powerlevel10k"
plugins=(git zsh-autosuggestions)
fpath+=("$ZSH/custom/plugins/zsh-completions/src")
# 補完の初期化は Oh My Zsh に任せる
[[ ! -r "$ZSH/oh-my-zsh.sh" ]] || source "$ZSH/oh-my-zsh.sh"
[[ ! -r "$HOME/.p10k.zsh" ]] || source "$HOME/.p10k.zsh"

alias ll='ls -laF'
alias dc='docker compose'

# 現在のディレクトリから親を辿って Python の仮想環境を有効化
activate() {
  local search_dir="$PWD"
  local venv_name="${1:-.venv}"
  while true; do
    if [[ -r "$search_dir/$venv_name/bin/activate" ]]; then
      source "$search_dir/$venv_name/bin/activate"
      print -r -- "Python のパス: $(command -v python)"
      return 0
    fi
    [[ "$search_dir" != / ]] || break
    search_dir="${search_dir:h}"
  done
  print -u2 -- "仮想環境が見つかりません: $venv_name"
  return 1
}

tks() {
  local answer
  read "answer?すべての tmux セッションを終了しますか？ [y/N] "
  if [[ "$answer" == y ]]; then
    tmux kill-server
  else
    print -- '中止しました'
  fi
}

# ブラケットペーストの制御文字が表示される問題への対策
unset zle_bracketed_paste
if (( $+commands[mise] )); then
  eval "$(mise activate zsh)"
fi

# 端末固有の設定は追跡しないファイルに記述する
[[ ! -r "$HOME/.zshrc.local" ]] || source "$HOME/.zshrc.local"
